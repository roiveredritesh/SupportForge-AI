{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VectorStore": {
    "Provider": "Chroma",
    "Chroma": { "BaseUrl": "http://localhost:8000" }
  },
  "Llm": {
    "_Provider": "Allowed values: \"NvidiaNim\" | \"OpenAI\" — selects which section below supplies BaseUrl/ChatModel/EmbeddingModel/ApiKey",
    "Provider": "NvidiaNim",
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1/",
      "ChatModel": "gpt-4o-mini",
      "EmbeddingModel": "text-embedding-3-small"
    },
    "NvidiaNim": {
      "BaseUrl": "https://integrate.api.nvidia.com/v1/",
      "ChatModel": "meta/llama-3.1-8b-instruct",
      "EmbeddingModel": "nvidia/nv-embedqa-e5-v5",
      "EmbeddingInputType": "query"
    }
  }
}
