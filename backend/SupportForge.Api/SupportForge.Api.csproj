<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2bc9eef2-cc26-4a2d-bd61-73672dfa1637</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- App_Data/repos holds git-cloned source ingested at runtime; the SDK's default globs would
         otherwise sweep those files into this project's own compilation. -->
    <Compile Remove="App_Data\**" />
    <Content Remove="App_Data\**" />
    <EmbeddedResource Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupportForge.Core\SupportForge.Core.csproj" />
    <ProjectReference Include="..\SupportForge.Agents\SupportForge.Agents.csproj" />
    <ProjectReference Include="..\SupportForge.VectorStore\SupportForge.VectorStore.csproj" />
    <ProjectReference Include="..\SupportForge.Common\SupportForge.Common.csproj" />
    <ProjectReference Include="..\SupportForge.Ingestion\SupportForge.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
