{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Llm": {
    "_Provider": "Allowed values: \"OpenAI\" | \"NvidiaNim\" | \"Ollama\" | \"Azure\" | \"Anthropic\" | \"Bedrock\" — same config shape as SupportForge.Api/appsettings.json, kept in sync so eval results reflect the provider actually used in production. Point Provider at \"Ollama\" to check judge quality on the self-hosted model before defaulting any verifier to it (see gap-closing-solutions.md Phase C, item 2).",
    "Provider": "NvidiaNim",
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1/",
      "ChatModel": "gpt-4o-mini"
    },
    "NvidiaNim": {
      "BaseUrl": "https://integrate.api.nvidia.com/v1/",
      "ChatModel": "nvidia/nemotron-3-ultra-550b-a55b",
    "CheapChatModel": "meta/llama-3.2-11b-vision-instruct",
    "VisionModel": "meta/llama-3.2-11b-vision-instruct",
    "RequestTimeout": "00:00:40"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434/v1/",
      "ChatModel": "llama3.1"
    },
    "Azure": {
      "BaseUrl": "https://<resource-name>.openai.azure.com",
      "ChatModel": "<chat-deployment-name>",
      "ApiKey": ""
    },
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ChatModel": "claude-sonnet-4-20250514",
      "ApiKey": ""
    },
    "Bedrock": {
      "Region": "us-east-1",
      "ChatModel": "anthropic.claude-3-5-sonnet-20241022-v2:0"
    }
  },
  "Guard": {
    "_Thresholds": "Kept in sync with SupportForge.Api/appsettings.json, so the guard eval reports detection at the shipped thresholds.",
    "Thresholds": {
      "override_instructions": 0.8,
      "extract_system_prompt": 0.85,
      "jailbreak_roleplay": 0.7,
      "cross_tenant_probe": 0.6,
      "extract_raw_code": 0.8,
      "obfuscated_payload": 0.8
    }
  },
  "Jev": {
    "BaseUrl": "https://api.typesafe.ai",
    "ApiKey": "",
    "Model": "jev-latest"
  }
}
