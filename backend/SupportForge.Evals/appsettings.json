{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Llm": {
    "_Provider": "Allowed values: \"OpenAI\" | \"NvidiaNim\" | \"Azure\" | \"Anthropic\" | \"Bedrock\" — same config shape as SupportForge.Api/appsettings.json, kept in sync so eval results reflect the provider actually used in production.",
    "Provider": "NvidiaNim",
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1/",
      "ChatModel": "gpt-4o-mini"
    },
    "NvidiaNim": {
      "BaseUrl": "https://integrate.api.nvidia.com/v1/",
      "ChatModel": "meta/llama-3.1-8b-instruct"
    },
    "Azure": {
      "BaseUrl": "https://<resource-name>.openai.azure.com",
      "ChatModel": "<chat-deployment-name>",
      "ApiKey": ""
    },
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ChatModel": "claude-sonnet-4-20250514",
      "ApiKey": ""
    },
    "Bedrock": {
      "Region": "us-east-1",
      "ChatModel": "anthropic.claude-3-5-sonnet-20241022-v2:0"
    }
  }
}
